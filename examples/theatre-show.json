  "keywords": [
    { "id": "66666666-6666-4666-8666-666666666661", "text": "standby", "highlightColor": "#ffd400" },
    { "id": "66666666-6666-4666-8666-666666666662", "text": "go", "highlightColor": "#3ddc84" },
    { "id": "66666666-6666-4666-8666-666666666663", "text": "hold", "highlightColor": "#ff5c5c" }
  ],
  "oscDestinations": [
    { "id": "77777777-7777-4777-8777-777777777771", "name": "QLab", "host": "127.0.0.1", "port": 53000 },
    { "id": "77777777-7777-4777-8777-777777777772", "name": "Eos console", "host": "192.168.1.50", "port": 8000, "enabled": false }
  ],
  "automations": [
    {
      "id": "88888888-8888-4888-8888-888888888881",
      "name": "Flash on HOLD",
      "policy": "cancelAndRestart",
      "trigger": { "type": "phrase", "phrases": ["hold please", "hold the show"], "early": true },
      "actions": [ { "type": "alert", "text": "HOLD", "seconds": 4, "color": "#d00000" } ]
    },
    {
      "id": "88888888-8888-4888-8888-888888888882",
      "name": "SM 'sound go' fires QLab",
      "policy": "ignoreIfRunning",
      "cooldownSeconds": 2,
      "trigger": { "type": "phrase", "phrases": ["sound go"], "channelIds": ["11111111-1111-4111-8111-111111111111"] },
      "actions": [
        { "type": "osc", "destinationId": "77777777-7777-4777-8777-777777777771", "address": "/go" },
        { "type": "sendText", "channelId": "44444444-4444-4444-8444-444444444444", "text": "QLab GO sent ({text})" }
      ]
    },
    {
      "id": "88888888-8888-4888-8888-888888888883",
      "name": "Log Eos cue fires",
      "policy": "runParallel",
      "trigger": { "type": "osc", "address": "/eos/out/event/cue/*/*/fire" },
      "actions": [ { "type": "sendText", "channelId": "44444444-4444-4444-8444-444444444444", "text": "Eos fired {address}" } ]
    }
  ],
  "settings": { "oscListenPort": 9000 }
}
